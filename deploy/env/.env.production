APP_NAME=HUBIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://cp.ip.mr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,ar,fr
APP_RTL_LOCALES=ar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubit
DB_USERNAME=hubit
DB_PASSWORD=hubit_production_secure_password_change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ip.mr

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.ip.mr
MAIL_PORT=587
MAIL_USERNAME=notify@ip.mr
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notify@ip.mr
MAIL_FROM_NAME="HUBIT Notifications"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Configuration
STRIPE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# cPanel/WHM Configuration
CPANEL_HOST=194.140.197.36
CPANEL_API_TOKEN=
CPANEL_USE_SSL=true
CPANEL_DEFAULT_PACKAGE=HUBIT_BASIC
CPANEL_NS1=ns1.ip.mr
CPANEL_NS2=ns2.ip.mr

# Company Information
COMPANY_NAME="IP MR"
COMPANY_EMAIL=contact@ip.mr
COMPANY_PHONE=
COMPANY_ADDRESS="Nouakchott, Mauritania"
COMPANY_TAX_ID=MRU123456
COMPANY_LOGO_URL=

# Invoice Settings
INVOICE_CURRENCY=USD
INVOICE_TAX_RATE=0
INVOICE_PREFIX=INV-
INVOICE_TERMS="Payment is due within 15 days"

# Security
SENTRY_DSN=
CSP_REPORT_URI=

# Feature Flags
FEATURE_2FA_ENABLED=true
FEATURE_REGISTRATIONS_ENABLED=true
FEATURE_MAINTENANCE_MODE=false
