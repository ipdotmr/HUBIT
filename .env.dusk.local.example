# Laravel Dusk E2E Test Environment
# Copy to .env.dusk.local and customize for local testing
# NEVER commit .env.dusk.local with real secrets

APP_NAME=HUBIT
APP_ENV=testing
APP_KEY=base64:test_key_here
APP_DEBUG=true
APP_URL=http://localhost

# Ensure browser tests run against the same SQLite database used in CI
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DATABASE_URL=

# Keep queues synchronous and mail in log driver for deterministic runs
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Dusk defaults
DUSK_HEADLESS=true
