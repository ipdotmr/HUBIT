# Application
APP_NAME=HUBIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://my.ip.mr

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,ar,fr
APP_RTL_LOCALES=ar

# Application Configuration
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# Security
BCRYPT_ROUNDS=12
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubit
DB_USERNAME=hubit
DB_PASSWORD=change_me

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ip.mr
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for S3 storage if needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment Gateways
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Provisioning Modules - cPanel/WHM
CPANEL_HOST=
CPANEL_API_TOKEN=
CPANEL_USE_SSL=true
CPANEL_DEFAULT_PACKAGE=HUBIT_BASIC

# Company & Branding
COMPANY_NAME="IP MR"
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=support@ip.mr
COMPANY_LOGO=
INVOICE_CURRENCY=USD
INVOICE_PREFIX=INV-

# Security & Monitoring
SENTRY_DSN=
CSP_REPORT_URI=

# Documentation
DOCS_SITE_URL=https://docs.ip.mr

# Theme
DEFAULT_THEME=classic
ENABLE_DARK_MODE=true

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

VITE_APP_NAME="${APP_NAME}"
