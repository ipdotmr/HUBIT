# Laravel Dusk E2E Test Environment
# Copy to .env.dusk.local and customize for local testing
# NEVER commit .env.dusk.local with real secrets

APP_NAME=HUBIT
APP_ENV=testing
APP_KEY=base64:test_key_here
APP_DEBUG=true
APP_URL=http://localhost

# Use mocks for deterministic E2E tests (no real API calls)
E2E_USE_MOCKS=true

# Database (use separate test database)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hubit_test
DB_USERNAME=hubit_test
DB_PASSWORD=test_password

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (log driver for tests)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=test@hubit.test
MAIL_FROM_NAME="HUBIT Test"

# Queue (sync for immediate execution in tests)
QUEUE_CONNECTION=sync

# Dusk-specific
DUSK_DRIVER_URL=http://localhost:9515
DUSK_HEADLESS=true

# For PR #4b live-sandbox testing, set these to real sandbox values:
# E2E_USE_MOCKS=false
# STRIPE_TEST_KEY=pk_test_...
# STRIPE_TEST_SECRET=sk_test_...
# CPANEL_HOST=test.whm.local
# CPANEL_API_TOKEN=...
# etc.
